# Application
DEBUG=True
SECRET_KEY="change-this-to-a-secure-secret-key"

# === Auth (Basic) ===
CLIENT_ID="client_id_here"
CLIENT_SECRET="client_secret_here"

# === OpenAI / LLM ===
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-mini"

MCP_SERVER_CMD=python
MCP_SERVER_ARGS="/app/data/food-tracker-mcp/food_tracker.py"
NUTRITION_TOOL_NAME="analyze_nutrition"
MAP_TOOL_NAME="map_to_barcode"

# === Data / caching ===
DATA_DIR=/app/data

database_url="postgresql://user:password@localhost:5432/dbname"
redis_url="redis://localhost:6379/0"

# === Optional: Telegram PHP bot REST to fetch stored dishes ===
TELEGRAM_API_BASE=""
TELEGRAM_API_TOKEN=""

HOST="0.0.0.0"
PORT=8000
