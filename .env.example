# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=ai_culinary_assistant

# Database URL (for application use in docker-compose)
# Note: Use 'db' as hostname when running in Docker, 'localhost' when running locally
DATABASE_URL=postgresql://postgres:your-secure-password@db:5432/ai_culinary_assistant

# Redis
# Note: Use 'redis' as hostname when running in Docker, 'localhost' when running locally
REDIS_URL=redis://redis:6379/0

# Application
DEBUG=True
SECRET_KEY=change-this-to-a-secure-secret-key
