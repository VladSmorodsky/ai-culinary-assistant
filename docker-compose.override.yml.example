# Local development overrides ONLY. Do not deploy this file to Easypanel/production.
services:
  assistant:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        - INSTALL_DEV=true
    container_name: meal-assistant
    ports:
      - "8000:8000"
    volumes:
      - ./:/app
      - ./data:/app/data
    env_file:
      - .env

networks:
    default:
        driver: bridge
